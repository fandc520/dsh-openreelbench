{
  "name": "dsh-creative-studio",
  "version": "0.1.0-alpha.0",
  "description": "AI creative studio for DeepSeek Harness: a gated four-stage pipeline (brief -> script -> assets -> compose) that turns one sentence into a narrated explainer video, with generation delegated to ComfyUI workflows and assembly done locally with FFmpeg. / DSH 的 AI 创意工作室：四段带审批闸的管线，生成走 ComfyUI，合成走 FFmpeg。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./client/client.js"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "prepare": "npm run build",
    "test": "node test/smoke.mjs",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "tsdown -c tsdown.config.mjs",
    "inspect": "node test/inspect.mjs"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "comfyui",
    "video",
    "ffmpeg",
    "pipeline"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.3.1",
    "tsdown": "^0.22.0",
    "typescript": "^5.6.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
